# Copy thành .env.local rồi điền giá trị. KHÔNG commit .env.local.

# Nguồn dữ liệu: mock | sheet | auto (auto = sheet nếu có SHEET_ID, ngược lại mock)
DATA_SOURCE=mock
SHEET_ID=
SHEET_TAB=Recap v11
# gid của tab (số sau #gid= trên URL) để link "Mở sheet" mở đúng tab
SHEET_GID=
# Server đọc lại sheet tối đa mỗi N giây (dùng chung cho mọi người xem)
DATA_CACHE_SECONDS=30
# Trình duyệt tự làm mới trang mỗi N giây (0 = tắt)
NEXT_PUBLIC_AUTO_REFRESH_SECONDS=30

# Đọc sheet riêng tư qua Google Service Account (share sheet quyền Viewer cho email này).
# Để trống thì web đọc CSV công khai (sheet phải bật "Anyone with the link can view").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key dạng một dòng, giữ nguyên các ký tự \n
GOOGLE_SERVICE_ACCOUNT_KEY=

# Claude Haiku viết phần nhận định AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Đăng nhập
# Chuỗi ngẫu nhiên ≥ 32 ký tự để ký cookie phiên (tạo bằng: openssl rand -hex 32)
AUTH_SECRET=
# Admin gốc: luôn đăng nhập được, dùng để tạo các tài khoản khác ở menu Tài khoản
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Nơi lưu tài khoản khi chạy trên Vercel (Vercel → Storage → Upstash Redis tự thêm 2 biến này).
# Để trống khi chạy local: tài khoản lưu ở data/users.json
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Bí mật cho Vercel Cron tạo báo cáo PDF tự động (01:00 giờ VN). Đặt chuỗi ngẫu nhiên dài trên Vercel.
CRON_SECRET=
