# Copy thành .env.local rồi điền giá trị. KHÔNG commit .env.local.

# Nguồn dữ liệu: mock | sheet | auto (auto = sheet nếu có SHEET_ID, ngược lại mock)
DATA_SOURCE=mock
SHEET_ID=
SHEET_TAB=Recap Log
# Server đọc lại sheet tối đa mỗi N giây (dùng chung cho mọi người xem)
DATA_CACHE_SECONDS=30
# Trình duyệt tự làm mới trang mỗi N giây (0 = tắt)
NEXT_PUBLIC_AUTO_REFRESH_SECONDS=30

# Đọc sheet riêng tư qua Google Service Account (share sheet quyền Viewer cho email này).
# Để trống thì web đọc CSV công khai (sheet phải bật "Anyone with the link can view").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key dạng một dòng, giữ nguyên các ký tự \n
GOOGLE_SERVICE_ACCOUNT_KEY=

# Claude Haiku viết phần nhận định AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
